#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# BMI088 production baseline: SPI2 DMA polling at 1 MHz, gyro before accel.
# -R 4 is ROTATION_YAW_180, matching the installed IMU orientation.
# DRDY remains disabled; see bmi088_analysis.md for measured rationale.
bmi088 -s -b 2 -G -R 4 -f 1000 start
bmi088 -s -b 2 -A -R 4 -f 1000 start

# BMI160 redundant IMU: SPI3 DMA polling at 1 MHz.
# -R 12 is ROTATION_PITCH_180, verified against the BMI088 gravity vector.
bmi160 -s -b 3 -R 12 -f 1000 start

# Internal baro
bmp280 -I -b 2 start
